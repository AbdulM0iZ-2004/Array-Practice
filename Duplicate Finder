#include <iostream>
using namespace std;

int main() {
    const int size = 10;
    int arr[size];
    bool foundDuplicate = false;

    cout << "Enter " << size << " numbers:\n";
    for (int i = 0; i < size; i++) {
        cout << "Number " << i + 1 << ": ";
        cin >> arr[i];
    }

    cout << "\nDuplicate numbers are: ";

    // Nested loops to find duplicates
    for (int i = 0; i < size; i++) {
        bool alreadyPrinted = false;  // To prevent printing same duplicate again

        // Check if this number was already printed before
        for (int k = 0; k < i; k++) {
            if (arr[i] == arr[k]) {
                alreadyPrinted = true;
                break;
            }
        }

        // Skip if already printed
        if (alreadyPrinted)
            continue;

        // Check for duplicates in rest of the array
        for (int j = i + 1; j < size; j++) {
            if (arr[i] == arr[j]) {
                cout << arr[i] << " ";
                foundDuplicate = true;
                break;
            }
        }
    }

    if (!foundDuplicate)
        cout << "None";

    cout << endl;
    return 0;
}
